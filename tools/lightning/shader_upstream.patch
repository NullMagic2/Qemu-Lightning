+/* Lightning private integration entry. Input tokens/signatures are genuine,
+ * caller-owned, validated snapshots. No DXBC container or semantic is invented. */
+int vkd3d_shader_compile_tokenized_desc(const struct vkd3d_shader_desc *shader_desc,
+        struct vkd3d_shader_code *spirv, struct vkd3d_shader_code_debug *spirv_debug,
+        unsigned int compiler_options,
+        const struct vkd3d_shader_interface_info *shader_interface_info,
+        const struct vkd3d_shader_compile_arguments *compile_args)
+{
+    struct vkd3d_shader_scan_info scan_info;
+    struct vkd3d_shader_parser parser;
+    struct vkd3d_shader_code code = {0};
+    int ret;
+
+    if ((ret = vkd3d_shader_validate_compile_args(compile_args)) < 0)
+        return ret;
+    memset(&spirv->meta, 0, sizeof(spirv->meta));
+    code.code = shader_desc->byte_code;
+    code.size = shader_desc->byte_code_size;
+    spirv->meta.hash = vkd3d_shader_hash(&code);
+    vkd3d_shader_scan_init(&scan_info);
+    if ((ret = vkd3d_shader_parser_init_desc(&parser, shader_desc)) < 0)
+    {
+        vkd3d_shader_scan_destroy(&scan_info);
+        return ret;
+    }
+    ret = vkd3d_shader_scan_parser(&parser, &scan_info);
+    vkd3d_shader_parser_destroy(&parser);
+    if (ret < 0)
+    {
+        vkd3d_shader_scan_destroy(&scan_info);
+        return ret;
+    }
+    spirv->meta.patch_vertex_count = scan_info.patch_vertex_count;
+    if ((ret = vkd3d_shader_parser_init_desc(&parser, shader_desc)) < 0)
+    {
+        vkd3d_shader_scan_destroy(&scan_info);
+        return ret;
+    }
+    ret = vkd3d_shader_compile_parser(&parser, &scan_info, spirv, spirv_debug,
+            compiler_options, shader_interface_info, compile_args);
+    vkd3d_shader_scan_destroy(&scan_info);
+    vkd3d_shader_parser_destroy(&parser);
+    return ret;
 }
 
