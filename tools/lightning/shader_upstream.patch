+/* Shared genuine instruction compiler for complete DXBC and native token input. */
+static int vkd3d_shader_compile_parser(struct vkd3d_shader_parser *parser,
+        struct vkd3d_shader_scan_info *scan_info, struct vkd3d_shader_code *spirv,
+        struct vkd3d_shader_code_debug *spirv_debug, unsigned int compiler_options,
+        const struct vkd3d_shader_interface_info *shader_interface_info,
+        const struct vkd3d_shader_compile_arguments *compile_args)
+{
+    struct vkd3d_shader_instruction instruction;
+    struct vkd3d_dxbc_compiler *spirv_compiler;
+    int ret = VKD3D_OK;
+
+    if (shader_interface_info)
+    {
+        if ((ret = vkd3d_shader_validate_shader_type(parser->shader_version.type, shader_interface_info->stage)) < 0)
+        {
+            return ret;
+        }
+    }
+
+    if (!(spirv_compiler = vkd3d_dxbc_compiler_create(&parser->shader_version,
+            &parser->shader_desc, compiler_options, shader_interface_info, compile_args, scan_info,
+            spirv->meta.hash)))
+    {
+        ERR("Failed to create DXBC compiler.\n");
+        return VKD3D_ERROR;
+    }
+
+    while (!shader_sm4_is_end(parser->data, &parser->ptr))
+    {
+        shader_sm4_read_instruction(parser->data, &parser->ptr, &instruction);
+
+        if (instruction.handler_idx == VKD3DSIH_INVALID)
+        {
+            WARN("Encountered unrecognized or invalid instruction.\n");
+            vkd3d_dxbc_compiler_destroy(spirv_compiler);
+            return VKD3D_ERROR_INVALID_ARGUMENT;
+        }
+
+        if ((ret = vkd3d_dxbc_compiler_handle_instruction(spirv_compiler, &instruction)) < 0)
+            break;
+    }
+
+    if (ret >= 0)
+        ret = vkd3d_dxbc_compiler_generate_spirv(spirv_compiler, spirv);
+
+    if (ret == 0)
+        vkd3d_shader_dump_spirv_shader(spirv->meta.hash, spirv);
+
+    if (spirv_debug)
+        memset(spirv_debug, 0, sizeof(*spirv_debug));
+
+    vkd3d_dxbc_compiler_destroy(spirv_compiler);
+    return ret;
+}
