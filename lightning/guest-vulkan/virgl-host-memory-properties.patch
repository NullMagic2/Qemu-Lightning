diff --git a/src/venus/vkr_context.c b/src/venus/vkr_context.c
index e309d76..bbc66a7 100644
--- a/src/venus/vkr_context.c
+++ b/src/venus/vkr_context.c
@@ -300,7 +300,10 @@ vkr_context_create_resource_from_shm(struct vkr_context *ctx,
    *out_blob = (struct virgl_context_blob){
       .type = VIRGL_RESOURCE_FD_SHM,
       .u.fd = fd,
-      .map_info = VIRGL_RENDERER_MAP_CACHE_CACHED,
+      .map_info = VIRGL_RENDERER_MAP_CACHE_CACHED |
+                  VIRGL_RENDERER_MAP_HOST_PROPERTIES_VALID |
+                  (VIRGL_RENDERER_HOST_MEMORY_MASK <<
+                   VIRGL_RENDERER_MAP_HOST_PROPERTIES_SHIFT),
