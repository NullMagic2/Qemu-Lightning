+static VkResult
+wsi_win32_native_result(HRESULT result)
+{
+   if (SUCCEEDED(result)) return VK_SUCCESS;
+   if (result == DXGI_ERROR_DEVICE_REMOVED || result == DXGI_ERROR_DEVICE_RESET ||
+       result == DXGI_ERROR_DEVICE_HUNG) return VK_ERROR_DEVICE_LOST;
+   if (result == E_OUTOFMEMORY) return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   return VK_ERROR_INITIALIZATION_FAILED;
+}
+
+static VkResult
+wsi_win32_native_image_memory(const struct wsi_swapchain *base,
+                              const struct wsi_image_info *info,
+                              struct wsi_image *image)
+{
+   auto *chain = (struct wsi_win32_swapchain *)base;
+   auto *win_image = container_of(image, struct wsi_win32_image, base);
+   uint32_t blob = 0;
+   VkResult result = wsi_win32_native_result(
+      qlg_wsi_image_create(chain->native, &win_image->native_image, &blob));
+   if (result != VK_SUCCESS) return result;
+   VkMemoryRequirements requirements;
+   base->wsi->GetImageMemoryRequirements(base->device, image->image, &requirements);
+   VkImportMemoryWin32HandleInfoKHR import_info = {};
+   import_info.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_WIN32_HANDLE_INFO_KHR;
+   import_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+   import_info.handle = (HANDLE)(uintptr_t)blob;
+   VkMemoryDedicatedAllocateInfo dedicated = {};
+   dedicated.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+   dedicated.pNext = &import_info; dedicated.image = image->image;
+   VkMemoryAllocateInfo allocate = {};
+   allocate.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+   allocate.pNext = &dedicated; allocate.allocationSize = requirements.size;
+   allocate.memoryTypeIndex = wsi_select_device_memory_type(base->wsi, requirements.memoryTypeBits);
+   return base->wsi->AllocateMemory(base->device, &allocate, &base->alloc, &image->memory);
+}
