@@ -1205,12 +1214,32 @@
          ctx->base.flush(&ctx->base, NULL, PIPE_FLUSH_HINT_FINISH);
          return true;
       } else { //multi-context
+         /* Lightning: another context's batch that is still recording is only
+          * submitted when that context flushes, and nothing makes it flush while
+          * this thread waits (a D3D device's writes become visible to other
+          * devices only after it flushes). Waiting hung Solitaire's frame window
+          * in WddmPresent after a minimize. Wait only for queued batches.
+          */
+         struct zink_batch_state *owner =
+            (struct zink_batch_state *)((char *)u - offsetof(struct zink_batch_state, usage));
+         if (owner->ctx != ctx && p_atomic_read(&owner->ctx->bs) == owner)
+            return false;
          mtx_lock(&u->mtx);
          if (trywait) {
             struct timespec ts = {0, 10000};
             cnd_timedwait(&u->flush, &u->mtx, &ts);
-         } else
-            cnd_wait(&u->flush, &u->mtx);
+         } else {
+            /* Lightning: re-check the predicate under the lock, and stop once
+             * the batch state was submitted and recycled. The 1 ms timeout
+             * bounds any wakeup that is still missed to 1 ms instead of a hang.
+             */
+            while (u->unflushed && u->submit_count == submit_count) {
+               struct timespec now, deadline;
+               timespec_get(&now, TIME_UTC);
+               timespec_add_msec(&deadline, &now, 1);
+               cnd_timedwait(&u->flush, &u->mtx, &deadline);
+            }
+         }
          mtx_unlock(&u->mtx);
       }
    }

