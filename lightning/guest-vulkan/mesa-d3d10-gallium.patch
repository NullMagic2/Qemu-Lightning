+   bool progress = nir_shader_intrinsics_pass(nir, lower_lightning_coverage_intrinsic,
+                                              nir_metadata_control_flow, &mode);
+   if (mode != QLG_TIR_MODE_SINGLE_OUTPUT_ALPHA || (nir->info.outputs_written & BITFIELD64_BIT(FRAG_RESULT_SAMPLE_MASK)))
+      return progress;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_variable *color = NULL;
+   nir_foreach_shader_out_variable(var, nir) {
