+/* D3D TIR separates raster coverage from output coverage. Vulkan's mixed
+ * samples merge coverage; a shader output mask therefore broadcasts bit zero.
+ * Center-sampled MSAA keeps the real output mask and folds only the input. */
+static bool
+lower_lightning_coverage_intrinsic(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   unsigned mode = *(unsigned *)data;
+   if (mode == QLG_TIR_MODE_CENTER_INPUT && intr->intrinsic == nir_intrinsic_load_sample_mask_in) {
+      b->cursor = nir_after_instr(&intr->instr);
+      nir_def *covered = nir_b2i32(b, nir_ine_imm(b, &intr->def, 0));
+      nir_def_rewrite_uses_after(&intr->def, covered);
+      return true;
+   }
+   if (mode < QLG_TIR_MODE_SINGLE_OUTPUT || intr->intrinsic != nir_intrinsic_store_deref)
+      return false;
+   nir_variable *var = nir_intrinsic_get_var(intr, 0);
+   if (!var || var->data.mode != nir_var_shader_out ||
+       var->data.location != FRAG_RESULT_SAMPLE_MASK)
+      return false;
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *enabled = nir_test_mask(b, intr->src[1].ssa, 1);
+   nir_def *mask = nir_bcsel(b, enabled, nir_imm_int(b, -1), nir_imm_int(b, 0));
+   nir_src_rewrite(&intr->src[1], mask);
+   return true;
