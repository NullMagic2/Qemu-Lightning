# Module: lightning.manager.icons
# Purpose: Index unmodified Yaru assets for the GTK 3 manager.
# Created: 2026-10-08
# Architecture: Falls back to installed Yaru and Adwaita for other icons.
[Icon Theme]
Name=Yaru-lightning
Comment=Yaru icons for QEMU-lightning
Inherits=Yaru,Adwaita,hicolor
Directories=scalable/actions,scalable/devices,48x48/devices,24x24/actions,24x24/places

[scalable/actions]
Size=16
Type=Scalable
MinSize=16
MaxSize=256
Context=Actions

[48x48/devices]
Size=48
Type=Fixed
Context=Devices

[scalable/devices]
Size=16
Type=Scalable
MinSize=16
MaxSize=256
Context=Devices

[24x24/actions]
Size=24
Type=Fixed
Context=Actions

[24x24/places]
Size=24
Type=Fixed
Context=Places
