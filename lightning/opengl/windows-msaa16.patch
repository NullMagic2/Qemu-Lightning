+/*
+ * Module: lightning.opengl.zink_msaa16
+ * Purpose: Describe independently stored sample banks for the private 16x path.
+ * Created: 2026-11-11
+ * Architecture: Zink owns Vulkan resources and synchronization; this adapter
+ * maps logical samples onto two disjoint native eight-sample array layers.
+ */
+#ifndef ZINK_MSAA16_H
+#define ZINK_MSAA16_H
+
+#define ZINK_MSAA16_SAMPLES 16u
+#define ZINK_MSAA16_BANK_SAMPLES 8u
+#define ZINK_MSAA16_BANKS 2u
+#define ZINK_MSAA16_BANK_SHIFT 3u
+#define ZINK_MSAA16_BANK_SAMPLE_MASK (ZINK_MSAA16_BANK_SAMPLES - 1)
+
+#endif
--- /dev/null
+++ b/src/gallium/drivers/zink/zink_msaa16_nir.h
@@ -0,0 +1,231 @@
+/*
+ * Module: lightning.opengl.zink_msaa16_nir
+ * Purpose: Map logical multisample texture/image operations onto native array banks.
+ * Created: 2026-11-11
+ * Architecture: Included by the pinned Zink compiler; the existing per-resource
+ * variant cache supplies immutable masks. No CPU pixel path is introduced.
+ */
+#ifndef ZINK_MSAA16_NIR_H
+#define ZINK_MSAA16_NIR_H
+
+struct lightning_msaa16_nir_state {
+   const struct zink_zs_swizzle_key *resources;
+};
+
+static nir_def *
+lightning_msaa16_binding_index(nir_builder *b, nir_deref_instr *deref)
+{
+   nir_variable *var = nir_deref_instr_get_variable(deref);
+   nir_def *index = nir_imm_int(b, var->data.driver_location);
+   for (nir_deref_instr *walk = deref; walk->deref_type != nir_deref_type_var;
+        walk = nir_deref_instr_parent(walk)) {
+      if (walk->deref_type == nir_deref_type_array) {
+         unsigned stride = glsl_type_is_array(walk->type) ? glsl_get_aoa_size(walk->type) : 1;
+         index = nir_iadd(b, index, nir_imul_imm(b, walk->arr.index.ssa, stride));
+      }
+   }
+   return index;
+}
+
+static nir_def *
+lightning_msaa16_is_banked(nir_builder *b, nir_deref_instr *deref, uint32_t mask)
+{
+   return nir_ine_imm(b, nir_iand_imm(b,
+      nir_ushr(b, nir_imm_int(b, mask), lightning_msaa16_binding_index(b, deref)), 1), 0);
+}
+
+static nir_def *
+lightning_msaa16_layer(nir_builder *b, nir_def *layer, nir_def *sample, nir_def *banked)
+{
+   nir_def *bank = sample ? nir_ushr_imm(b, sample, ZINK_MSAA16_BANK_SHIFT) : nir_imm_int(b, 0);
+   nir_def *physical = nir_iadd(b, nir_imul_imm(b, layer, ZINK_MSAA16_BANKS), bank);
+   return nir_bcsel(b, banked, physical, layer);
+}
+
+static bool
+lightning_msaa16_lower_tex(nir_builder *b, nir_tex_instr *tex, const struct zink_zs_swizzle_key *resources)
+{
+   if (tex->sampler_dim != GLSL_SAMPLER_DIM_MS)
+      return false;
+   int deref_index = nir_tex_instr_src_index(tex, nir_tex_src_texture_deref);
+   if (deref_index < 0)
+      return false;
+
+   nir_deref_instr *deref = nir_src_as_deref(tex->src[deref_index].src);
+   b->cursor = nir_before_instr(&tex->instr);
+   uint32_t mask = resources ? resources->lightning_msaa16_samplers : 0;
+   nir_def *banked = lightning_msaa16_is_banked(b, deref, mask);
+   bool was_array = tex->is_array;
+   tex->is_array = true;
+   int coord_index = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+   int sample_index = nir_tex_instr_src_index(tex, nir_tex_src_ms_index);
+   if (coord_index >= 0) {
+      nir_def *coord = tex->src[coord_index].src.ssa;
+      nir_def *sample = sample_index >= 0 ? tex->src[sample_index].src.ssa : NULL;
+      nir_def *layer = was_array ? nir_channel(b, coord, 2) : nir_imm_int(b, 0);
+      nir_def *physical_coord = nir_vec3(b, nir_channel(b, coord, 0), nir_channel(b, coord, 1),
+         lightning_msaa16_layer(b, layer, sample, banked));
+      nir_src_rewrite(&tex->src[coord_index].src, physical_coord);
+      tex->coord_components = 3;
+      if (sample) {
+         nir_def *physical_sample = nir_bcsel(b, banked,
+            nir_iand_imm(b, sample, ZINK_MSAA16_BANK_SAMPLE_MASK), sample);
+         nir_src_rewrite(&tex->src[sample_index].src, physical_sample);
+      }
+   }
+   b->cursor = nir_after_instr(&tex->instr);
+   if (tex->op == nir_texop_txs) {
+      tex->def.num_components = 3;
+      nir_def *size = was_array ? nir_vec3(b, nir_channel(b, &tex->def, 0),
+         nir_channel(b, &tex->def, 1), nir_bcsel(b, banked,
+            nir_ushr_imm(b, nir_channel(b, &tex->def, 2), 1), nir_channel(b, &tex->def, 2))) :
+         nir_trim_vector(b, &tex->def, 2);
+      nir_def_rewrite_uses_after(&tex->def, size);
+   } else if (tex->op == nir_texop_texture_samples) {
+      nir_def *samples = nir_bcsel(b, banked,
+         nir_imul_imm(b, &tex->def, ZINK_MSAA16_BANKS), &tex->def);
+      nir_def_rewrite_uses_after(&tex->def, samples);
+   } else if (tex->op == nir_texop_samples_identical) {
+      /* Eight equal values in one bank do not establish equality across both. */
+      nir_def *identical = nir_bcsel(b, banked, nir_imm_false(b), &tex->def);
+      nir_def_rewrite_uses_after(&tex->def, identical);
+   }
+   return true;
+}
+
+static bool
+lightning_msaa16_lower_image(nir_builder *b, nir_intrinsic_instr *intr,
+                            const struct zink_zs_swizzle_key *resources)
+{
+   if (!nir_intrinsic_has_image_dim(intr) || nir_intrinsic_image_dim(intr) != GLSL_SAMPLER_DIM_MS)
+      return false;
+   switch (intr->intrinsic) {
+   case nir_intrinsic_image_deref_load:
+   case nir_intrinsic_image_deref_sparse_load:
+   case nir_intrinsic_image_deref_store:
+   case nir_intrinsic_image_deref_atomic:
+   case nir_intrinsic_image_deref_atomic_swap:
+   case nir_intrinsic_image_deref_size:
+   case nir_intrinsic_image_deref_samples:
+      break;
+   default:
+      return false;
+   }
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_deref_instr *deref = nir_src_as_deref(intr->src[0]);
+   uint32_t mask = resources ? resources->lightning_msaa16_images : 0;
+   nir_def *banked = lightning_msaa16_is_banked(b, deref, mask);
+   bool was_array = nir_intrinsic_image_array(intr);
+   nir_intrinsic_set_image_array(intr, true);
+   if (intr->intrinsic != nir_intrinsic_image_deref_size && intr->intrinsic != nir_intrinsic_image_deref_samples) {
+      nir_def *coord = intr->src[1].ssa;
+      nir_def *sample = intr->src[2].ssa;
+      nir_def *layer = was_array ? nir_channel(b, coord, 2) : nir_imm_int(b, 0);
+      nir_def *physical_coord = nir_vector_insert_imm(b, coord,
+         lightning_msaa16_layer(b, layer, sample, banked), 2);
+      nir_src_rewrite(&intr->src[1], physical_coord);
+      nir_src_rewrite(&intr->src[2], nir_bcsel(b, banked,
+         nir_iand_imm(b, sample, ZINK_MSAA16_BANK_SAMPLE_MASK), sample));
+   }
+   b->cursor = nir_after_instr(&intr->instr);
+   if (intr->intrinsic == nir_intrinsic_image_deref_size) {
+      intr->def.num_components = 3;
+      nir_def *size = was_array ? nir_vec3(b, nir_channel(b, &intr->def, 0),
+         nir_channel(b, &intr->def, 1), nir_bcsel(b, banked,
+            nir_ushr_imm(b, nir_channel(b, &intr->def, 2), 1), nir_channel(b, &intr->def, 2))) :
+         nir_trim_vector(b, &intr->def, 2);
+      nir_def_rewrite_uses_after(&intr->def, size);
+   } else if (intr->intrinsic == nir_intrinsic_image_deref_samples) {
+      nir_def *samples = nir_bcsel(b, banked,
+         nir_imul_imm(b, &intr->def, ZINK_MSAA16_BANKS), &intr->def);
+      nir_def_rewrite_uses_after(&intr->def, samples);
+   }
+   return true;
+}
+
+static bool
+lightning_msaa16_lower_instr(nir_builder *b, nir_instr *instr, void *data)
+{
+   struct lightning_msaa16_nir_state *state = data;
+   if (instr->type == nir_instr_type_tex)
+      return lightning_msaa16_lower_tex(b, nir_instr_as_tex(instr), state->resources);
+   if (instr->type == nir_instr_type_intrinsic)
+      return lightning_msaa16_lower_image(b, nir_instr_as_intrinsic(instr), state->resources);
+   return false;
+}
+
+static const struct glsl_type *
+lightning_msaa16_array_type(const struct glsl_type *type)
+{
+   if (glsl_type_is_array(type))
+      return glsl_array_type(lightning_msaa16_array_type(glsl_get_array_element(type)), glsl_get_length(type), 0);
+   if (glsl_type_is_sampler(type))
+      return glsl_sampler_type(GLSL_SAMPLER_DIM_MS, glsl_sampler_type_is_shadow(type), true, glsl_get_sampler_result_type(type));
+   return glsl_image_type(GLSL_SAMPLER_DIM_MS, true, glsl_get_sampler_result_type(type));
+}
+
+static bool
+lightning_msaa16_lower(nir_shader *nir, const void *resources)
+{
+   struct lightning_msaa16_nir_state state = {resources};
+   bool progress = nir_shader_instructions_pass(nir, lightning_msaa16_lower_instr,
+      nir_metadata_control_flow, &state);
+   if (progress) {
+      nir_foreach_variable_with_modes(var, nir, nir_var_uniform | nir_var_image) {
+         const struct glsl_type *type = glsl_without_array(var->type);
+         if (!var->data.bindless && (glsl_type_is_sampler(type) || glsl_type_is_image(type)) &&
+             glsl_get_sampler_dim(type) == GLSL_SAMPLER_DIM_MS)
+            var->type = lightning_msaa16_array_type(var->type);
+      }
+      nir_fixup_deref_types(nir);
+   }
+   return progress;
+}
+/* Translate application-visible sample builtins before internal framebuffer
+ * fetch lowering inserts physical sample IDs. Every bank executes eight native
+ * sample invocations; application outputs remain in logical sixteen-bit space.
+ */
+static bool
+lightning_msaa16_fragment_instr(nir_builder *b, nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+   nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+   b->cursor = nir_before_instr(instr);
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_sample_id:
+   case nir_intrinsic_load_sample_mask_in: {
+      b->cursor = nir_after_instr(instr);
+      nir_def *base = nir_load_push_constant_zink(b, 1, 32,
+         nir_imm_int(b, ZINK_GFX_PUSHCONST_LIGHTNING_SAMPLE_BASE));
+      nir_def *logical = intr->intrinsic == nir_intrinsic_load_sample_id ?
+         nir_iadd(b, &intr->def, base) : nir_ishl(b, &intr->def, base);
+      nir_def_rewrite_uses_after(&intr->def, logical);
+      return true;
+   }
+   case nir_intrinsic_interp_deref_at_sample:
+      nir_src_rewrite(&intr->src[1], nir_iand_imm(b, intr->src[1].ssa,
+         ZINK_MSAA16_BANK_SAMPLE_MASK));
+      return true;
+   case nir_intrinsic_store_deref: {
+      nir_variable *var = nir_intrinsic_get_var(intr, 0);
+      if (var->data.mode != nir_var_shader_out || var->data.location != FRAG_RESULT_SAMPLE_MASK)
+         return false;
+      nir_def *base = nir_load_push_constant_zink(b, 1, 32,
+         nir_imm_int(b, ZINK_GFX_PUSHCONST_LIGHTNING_SAMPLE_BASE));
+      nir_src_rewrite(&intr->src[1], nir_ushr(b, intr->src[1].ssa, base));
+      return true;
+   }
+   default:
+      return false;
+   }
+}
+
+static bool
+lightning_msaa16_lower_fragment(nir_shader *nir)
+{
+   return nir_shader_instructions_pass(nir, lightning_msaa16_fragment_instr,
+      nir_metadata_control_flow, NULL);
+}
