# Module: qemu_lightning.opengl.reactos_import_audit
# Purpose: Check the built PE32 pair and helper imports against actual release DLL exports.
# Created: 2026-10-21
# Architecture: Read-only binutils build validation; never loads or executes a target DLL.
foreach(required QL_OBJDUMP QL_PACKAGE QL_SYSTEM32)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ReactOS import audit input: ${required}")
    endif()
endforeach()

# Architecture parameter (default i386): every module and dependency must be
# this exact PE machine type; a native x64 ReactOS has no 32-bit subsystem.
if(NOT DEFINED QL_REACTOS_ARCH OR QL_REACTOS_ARCH STREQUAL "")
    set(QL_REACTOS_ARCH i386)
endif()
if(QL_REACTOS_ARCH STREQUAL "i386")
    set(ql_pe_format "pei-i386")
    set(ql_pe_label "PE32 i386")
elseif(QL_REACTOS_ARCH STREQUAL "amd64")
    set(ql_pe_format "pei-x86-64")
    set(ql_pe_label "PE32+ AMD64")
else()
    message(FATAL_ERROR "Unsupported ReactOS import audit architecture: ${QL_REACTOS_ARCH}")
endif()

function(inspect_image file output)
    execute_process(COMMAND "${QL_OBJDUMP}" -p "${file}"
        OUTPUT_VARIABLE description COMMAND_ERROR_IS_FATAL ANY)
    if(NOT description MATCHES "file format ${ql_pe_format}")
        message(FATAL_ERROR "Expected a ${ql_pe_label} module: ${file}")
    endif()
    set(${output} "${description}" PARENT_SCOPE)
endfunction()

function(find_module name output)
    string(TOLOWER "${name}" lower)
    if(EXISTS "${QL_PACKAGE}/${name}")
        set(file "${QL_PACKAGE}/${name}")
    else()
        set(file "${QL_SYSTEM32}/${lower}")
    endif()
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "Target dependency unavailable for import audit: ${file}")
    endif()
    set(${output} "${file}" PARENT_SCOPE)
endfunction()

set(report "ReactOS ${QL_REACTOS_ARCH} static import audit; target DLLs are inspected without execution.\n")
set(total 0)
if(NOT DEFINED QL_MODULES)
    set(QL_MODULES opengl32.dll QemuLightningOpenGL.dll)
endif()
list(APPEND QL_MODULES kernel32_vista.dll ntdll_vista.dll)
list(REMOVE_DUPLICATES QL_MODULES)
if(NOT DEFINED QL_REPORT)
    set(QL_REPORT "${QL_PACKAGE}/reactos-import-audit.txt")
endif()
foreach(module IN LISTS QL_MODULES)
    find_module("${module}" file)
    inspect_image("${file}" description)
    file(SHA256 "${file}" hash)
    string(APPEND report "\n${module} SHA256 ${hash}\n")
    string(FIND "${description}" "The Import Tables" imports_start)
    string(FIND "${description}" "The Export Tables" imports_end)
    if(imports_end LESS 0)
        string(FIND "${description}" "PE File Base Relocations" imports_end)
    endif()
    if(imports_end LESS 0)
        string(LENGTH "${description}" imports_end)
    endif()
    if(imports_start LESS 0 OR imports_end LESS imports_start)
        message(FATAL_ERROR "Cannot locate import table for ${module}")
    endif()
    math(EXPR imports_size "${imports_end} - ${imports_start}")
    string(SUBSTRING "${description}" ${imports_start} ${imports_size} imports)
    string(REPLACE "\n" ";" lines "${imports}")
    set(dependency "")
    set(checked 0)
    foreach(line IN LISTS lines)
        if(line MATCHES "DLL Name: ([A-Za-z0-9_.-]+)")
            set(dependency "${CMAKE_MATCH_1}")
            find_module("${dependency}" target)
            inspect_image("${target}" exports)
            file(SHA256 "${target}" target_hash)
            string(APPEND report "  ${dependency} SHA256 ${target_hash}\n")
            string(FIND "${exports}" "[Ordinal/Name Pointer] Table" export_start)
            if(export_start LESS 0)
                message(FATAL_ERROR "Cannot locate export names for ${target}")
            endif()
            string(SUBSTRING "${exports}" ${export_start} -1 exports)
            string(FIND "${exports}" "PE File Base Relocations" export_end)
            if(NOT export_end LESS 0)
                string(SUBSTRING "${exports}" 0 ${export_end} exports)
            endif()
        elseif(line MATCHES "^[ \t]+[0-9a-fA-F]+[ \t]+<none>[ \t]+[0-9a-fA-F]+[ \t]+([A-Za-z0-9_@]+)[ \t]*$")
            set(symbol "${CMAKE_MATCH_1}")
            if(dependency STREQUAL "" OR NOT exports MATCHES "[ \t]${symbol}[\r\n]")
                message(FATAL_ERROR "Missing target export: ${module} -> ${dependency}!${symbol}")
            endif()
            string(APPEND report "    ${symbol}: exported\n")
            math(EXPR checked "${checked} + 1")
        elseif(line MATCHES "^[ \t]+[0-9a-fA-F]+[ \t]+[0-9]+[ \t]+<none>")
            message(FATAL_ERROR "Ordinal imports require explicit target review: ${module}: ${line}")
        elseif(line MATCHES "<none>")
            message(FATAL_ERROR "Unrecognized import entry: ${module}: ${line}")
        endif()
    endforeach()
    if(checked EQUAL 0)
        message(FATAL_ERROR "No named imports checked for ${module}; unsupported binutils output")
    endif()
    math(EXPR total "${total} + ${checked}")
    string(APPEND report "Checked ${checked} named imports.\n")
endforeach()
string(APPEND report "\nPASS: ${total} named imports exist in the exact target DLLs.\n"
    "This does not test function semantics, runtime loading, Vulkan transport or acceleration.\n")
file(WRITE "${QL_REPORT}" "${report}")
message(STATUS "ReactOS ${QL_REACTOS_ARCH} static imports: ${total} exact target exports verified")
