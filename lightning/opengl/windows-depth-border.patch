+sampler_surface_needs_clamped(struct zink_screen *screen, enum pipe_format format)
+{
+   /* The view retains its logical UNORM format after the resource falls back
+    * to floating-point storage. Compare the actual Vulkan format instead of
+    * asking the logical format to be both UNORM and FLOAT simultaneously. */
+   enum pipe_format depth = util_format_get_depth_only(format);
+   if (depth != PIPE_FORMAT_Z24X8_UNORM && depth != PIPE_FORMAT_X8Z24_UNORM)
+      return false;
+   VkFormat storage = zink_get_format(screen, format);
+   return storage == VK_FORMAT_D32_SFLOAT || storage == VK_FORMAT_D32_SFLOAT_S8_UINT;
