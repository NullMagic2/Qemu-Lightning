diff --git a/src/gallium/drivers/zink/zink_batch.c b/src/gallium/drivers/zink/zink_batch.c
index e76470d..791cfe0 100644
--- a/src/gallium/drivers/zink/zink_batch.c
+++ b/src/gallium/drivers/zink/zink_batch.c
@@ -7,6 +7,7 @@
 #include "zink_resource.h"
 #include "zink_screen.h"
 #include "zink_surface.h"
+#include "util/timespec.h"
 
 #ifdef VK_USE_PLATFORM_METAL_EXT
 #include "QuartzCore/CAMetalLayer.h"
@@ -654,7 +655,13 @@ submit_queue(void *data, void *gdata, int thread_index)
       bs->fence.batch_id = (uint32_t)p_atomic_inc_return(&screen->curr_batch);
    bs->usage.usage = bs->fence.batch_id;
    assert(bs->usage.usage);
+   /* Lightning: publish under the lock the unflushed waiter checks under, so
+    * the predicate and the broadcast below cannot slip between its check and
+    * its cnd_wait (a lost wakeup hung WebView2's GPU process).
+    */
+   mtx_lock(&bs->usage.mtx);
    bs->usage.unflushed = false;
+   mtx_unlock(&bs->usage.mtx);
 
    uint64_t batch_id = bs->fence.batch_id;
    /* first submit is just for acquire waits since they have a separate array */
@@ -843,7 +850,9 @@ submit_queue(void *data, void *gdata, int thread_index)
 
    bs->usage.submit_count++;
 end:
+   mtx_lock(&bs->usage.mtx);
    cnd_broadcast(&bs->usage.flush);
+   mtx_unlock(&bs->usage.mtx);
 
    post_submit(bs, screen);
 
@@ -1209,8 +1218,18 @@ zink_batch_usage_unflushed_wait(struct zink_context *ctx, struct zink_batch_usag
          if (trywait) {
             struct timespec ts = {0, 10000};
             cnd_timedwait(&u->flush, &u->mtx, &ts);
-         } else
-            cnd_wait(&u->flush, &u->mtx);
+         } else {
+            /* Lightning: re-check the predicate under the lock, and stop once
+             * the batch state was submitted and recycled. The 1 ms timeout
+             * bounds any wakeup that is still missed to 1 ms instead of a hang.
+             */
+            while (u->unflushed && u->submit_count == submit_count) {
+               struct timespec now, deadline;
+               timespec_get(&now, TIME_UTC);
+               timespec_add_msec(&deadline, &now, 1);
+               cnd_timedwait(&u->flush, &u->mtx, &deadline);
+            }
+         }
          mtx_unlock(&u->mtx);
       }
    }
